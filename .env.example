# ==============================================================================
# Checkout Service — Variáveis de Ambiente (Render + Neon PostgreSQL)
# ==============================================================================
PORT=8081

# Banco de Dados (omitir para usar H2 em memória localmente; configurar para Neon em produção)
# Exemplo Neon: jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/checkoutdb?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_POOL_MAX_SIZE=5

# Segurança (MESMA chave configurada no BFF Next.js / Vercel)
INTERNAL_API_KEY=

# Mantenha false em produção para evitar RCE (H2 Console), vazamento de SQL e exposição de docs (Swagger)
H2_CONSOLE_ENABLED=false
SWAGGER_ENABLED=false
JPA_SHOW_SQL=false

# No Render, defina true (o Render atua como reverse proxy confiável)
TRUST_PROXY_HEADERS=true

# Rate limiting e limites de retenção
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITE_RPM=30
RATE_LIMIT_READ_RPM=120
ORDERS_RETENTION_HOURS=24
MAX_STORED_ORDERS=2000
MAX_LIST_RESULTS=100
